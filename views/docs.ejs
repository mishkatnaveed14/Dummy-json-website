<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="Get started with DataDino placeholder JSON data.">
    <title>Docs — DataDino</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="docs-page">
        <section class="docs-intro" aria-labelledby="docs-title">
            <p class="docs-intro__eyebrow">DATADINO DOCS</p>
            <h1 id="docs-title">Build faster with mock data.</h1>
            <p>Use ready-to-fetch JSON while you build and test your frontend. No backend setup required.</p>
        </section>

        <section class="docs-card" aria-labelledby="quick-start-title">
            <div class="docs-card__heading">
                <span class="docs-card__step">01</span>
                <div>
                    <h2 id="quick-start-title">Quick start</h2>
                    <p>Fetch a sample collection and use it in your app.</p>
                </div>
            </div>
            <pre class="docs-code"><code>const response = await fetch("https://dummyjson.com/users");
const { users } = await response.json();

console.log(users);</code></pre>
            <a class="docs-back-link" href="/">
                Back to home
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
