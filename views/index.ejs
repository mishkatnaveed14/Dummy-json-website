<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="Explore DataDino, a free fake REST API for placeholder JSON data.">
    <title>DataDino — Placeholder JSON, ready to use</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="home-hero" aria-labelledby="hero-title">
            <div class="home-hero__content">
                <h1 class="home-hero__title" id="hero-title">
                    Free Fake REST API for<br class="home-hero__desktop-break">
                    Placeholder JSON Data
                    <svg class="home-hero__spark" viewBox="0 0 40 40" aria-hidden="true">
                        <path d="M20 3.5 25.2 14l11.3 1.6-8.2 8 1.9 11.3L20 29.5 9.8 34.9l1.9-11.3-8.2-8L14.8 14 20 3.5Z" fill="#b9b6ff" stroke="#171717" stroke-width="2.5" stroke-linejoin="round"/>
                    </svg>
                </h1>
                <p class="home-hero__tagline">Develop. Build. Test.</p>
                <p class="home-hero__description">
                    Get instant dummy JSON data for your frontend with DataDino —
                    no backend setup needed.
                </p>

                <div class="home-hero__actions">
                    <a class="home-hero__button home-hero__button--github" href="https://github.com/mishkatnaveed14/squarespace-landingpage-Backened" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.61 1.22 3.25.93.1-.72.4-1.22.71-1.5-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.16-3-.12-.29-.5-1.42.11-2.96 0 0 .95-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.1-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.67.11 2.96.72.78 1.16 1.78 1.16 3 0 4.29-2.62 5.23-5.11 5.51.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/>
                        </svg>
                        <span>View on GitHub</span>
                    </a>
                    <a class="home-hero__button home-hero__button--docs" href="/docs">Read Docs</a>
                </div>

                <p class="home-hero__note">No backend setup required. Start building in seconds.</p>
            </div>

            <a class="home-hero__scroll" href="#sponsors" aria-label="Scroll to sponsors">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3v17m-7-7 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </section>

        <section class="sponsor-section" id="sponsors" aria-labelledby="sponsor-title">
            <div class="sponsor-section__content">
                <h2 class="sponsor-section__eyebrow" id="sponsor-title">
                    <svg viewBox="0 0 40 40" aria-hidden="true">
                        <path d="M20 3.5 25.2 14l11.3 1.6-8.2 8 1.9 11.3L20 29.5 9.8 34.9l1.9-11.3-8.2-8L14.8 14 20 3.5Z" fill="#b9b6ff" stroke="#171717" stroke-width="2.5" stroke-linejoin="round"/>
                    </svg>
                    <span>Proudly sponsored by</span>
                </h2>

                <div class="sponsor-section__cards">
                    <a class="sponsor-card sponsor-card--blyto" href="https://blyto.com/?utm_source=dummyjson&utm_medium=sponsorship" target="_blank" rel="noopener noreferrer">
                        <span class="sponsor-card__icon sponsor-card__icon--link" aria-hidden="true">
                            <svg viewBox="0 0 40 40">
                                <path d="m16.1 24.3 7.8-8.6m-2.2-4.1 1.1-1.2a5.1 5.1 0 0 1 7.2 7.2l-4.2 4.2a5.1 5.1 0 0 1-7.2 0m-2.5 6.9-1.1 1.2a5.1 5.1 0 0 1-7.2-7.2l4.2-4.2a5.1 5.1 0 0 1 7.2 0" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="sponsor-card__copy">
                            <span class="sponsor-card__name">Bly.to</span>
                            <span class="sponsor-card__description">Just POST a link. Get a short one back.</span>
                        </span>
                        <svg class="sponsor-card__arrow" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>

                    <a class="sponsor-card sponsor-card--inbox" href="https://dummyinbox.com/?utm_source=dummyjson&utm_medium=sponsorship" target="_blank" rel="noopener noreferrer">
                        <span class="sponsor-card__icon sponsor-card__icon--inbox" aria-hidden="true">
                            <svg viewBox="0 0 40 40">
                                <rect x="5" y="9" width="30" height="23" rx="5" fill="#e68162"/>
                                <path d="m8 13 12 9 12-9M8 13v15h24V13" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="m8 13 12 9 12-9" fill="#fff2ed" stroke="#b94f39" stroke-width="1.5" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="sponsor-card__copy">
                            <span class="sponsor-card__name">DummyInbox</span>
                            <span class="sponsor-card__description">Get free temporary and disposable emails in seconds.</span>
                        </span>
                        <svg class="sponsor-card__arrow" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </div>

                <a class="sponsor-section__cta" href="https://github.com/sponsors/mishkatnaveed14" target="_blank" rel="noopener noreferrer">Become a sponsor</a>
            </div>

            <a class="sponsor-section__scroll" href="#site-footer" aria-label="Continue to the footer">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3v17m-7-7 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>