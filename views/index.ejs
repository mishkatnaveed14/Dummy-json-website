<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="Explore DataDino, a free fake REST API for placeholder JSON data.">
    <title>DataDino — Placeholder JSON, ready to use</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/header') %>

        <main>
            <section class="home-hero" aria-labelledby="hero-title">
                <div class="home-hero__content">
                    <h1 class="home-hero__title" id="hero-title">
                        Free Fake REST API for<br class="home-hero__desktop-break">
                        Placeholder JSON Data
                        <svg class="home-hero__spark" viewBox="0 0 40 40" aria-hidden="true">
                            <path
                                d="M20 3.5 25.2 14l11.3 1.6-8.2 8 1.9 11.3L20 29.5 9.8 34.9l1.9-11.3-8.2-8L14.8 14 20 3.5Z"
                                fill="#b9b6ff" stroke="#171717" stroke-width="2.5" stroke-linejoin="round" />
                        </svg>
                    </h1>
                    <p class="home-hero__tagline">Develop. Build. Test.</p>
                    <p class="home-hero__description">
                        Get instant dummy JSON data for your frontend with DataDino —
                        no backend setup needed.
                    </p>

                    <div class="home-hero__actions">
                        <a class="home-hero__button home-hero__button--github"
                            href="https://github.com/mishkatnaveed14/squarespace-landingpage-Backened" target="_blank"
                            rel="noopener noreferrer">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor"
                                    d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.61 1.22 3.25.93.1-.72.4-1.22.71-1.5-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.16-3-.12-.29-.5-1.42.11-2.96 0 0 .95-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.1-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.67.11 2.96.72.78 1.16 1.78 1.16 3 0 4.29-2.62 5.23-5.11 5.51.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
                            </svg>
                            <span>View on GitHub</span>
                        </a>
                        <a class="home-hero__button home-hero__button--docs" href="/docs">Read Docs</a>
                    </div>

                    <p class="home-hero__note">No backend setup required. Start building in seconds.</p>
                </div>

                <a class="home-hero__scroll" href="#sponsors" aria-label="Scroll to sponsors">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v17m-7-7 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.7"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </section>

            <section class="sponsor-section" id="sponsors" aria-labelledby="sponsor-title">
                <div class="sponsor-section__content">
                    <h2 class="sponsor-section__eyebrow" id="sponsor-title">
                        <svg viewBox="0 0 40 40" aria-hidden="true">
                            <path
                                d="M20 3.5 25.2 14l11.3 1.6-8.2 8 1.9 11.3L20 29.5 9.8 34.9l1.9-11.3-8.2-8L14.8 14 20 3.5Z"
                                fill="#b9b6ff" stroke="#171717" stroke-width="2.5" stroke-linejoin="round" />
                        </svg>
                        <span>Proudly sponsored by</span>
                    </h2>

                    <div class="sponsor-section__cards">
                        <a class="sponsor-card sponsor-card--blyto"
                            href="https://blyto.com/?utm_source=dummyjson&utm_medium=sponsorship" target="_blank"
                            rel="noopener noreferrer">
                            <span class="sponsor-card__icon sponsor-card__icon--link" aria-hidden="true">
                                <svg viewBox="0 0 40 40">
                                    <path
                                        d="m16.1 24.3 7.8-8.6m-2.2-4.1 1.1-1.2a5.1 5.1 0 0 1 7.2 7.2l-4.2 4.2a5.1 5.1 0 0 1-7.2 0m-2.5 6.9-1.1 1.2a5.1 5.1 0 0 1-7.2-7.2l4.2-4.2a5.1 5.1 0 0 1 7.2 0"
                                        fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"
                                        stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span class="sponsor-card__copy">
                                <span class="sponsor-card__name">Bly.to</span>
                                <span class="sponsor-card__description">Just POST a link. Get a short one back.</span>
                            </span>
                            <svg class="sponsor-card__arrow" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7"
                                    stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>

                        <a class="sponsor-card sponsor-card--inbox"
                            href="https://dummyinbox.com/?utm_source=dummyjson&utm_medium=sponsorship" target="_blank"
                            rel="noopener noreferrer">
                            <span class="sponsor-card__icon sponsor-card__icon--inbox" aria-hidden="true">
                                <svg viewBox="0 0 40 40">
                                    <rect x="5" y="9" width="30" height="23" rx="5" fill="#e68162" />
                                    <path d="m8 13 12 9 12-9M8 13v15h24V13" fill="none" stroke="#fff" stroke-width="2.2"
                                        stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="m8 13 12 9 12-9" fill="#fff2ed" stroke="#b94f39" stroke-width="1.5"
                                        stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span class="sponsor-card__copy">
                                <span class="sponsor-card__name">DummyInbox</span>
                                <span class="sponsor-card__description">Get free temporary and disposable emails in
                                    seconds.</span>
                            </span>
                            <svg class="sponsor-card__arrow" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7"
                                    stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>

                    <a class="sponsor-section__cta" href="https://github.com/sponsors/mishkatnaveed14" target="_blank"
                        rel="noopener noreferrer">Become a sponsor</a>
                </div>

                <a class="sponsor-section__scroll" href="#feature-text" aria-label="Continue to the features">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v17m-7-7 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.7"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </section>

            <section class="feature-section feature-section--text" id="feature-text"
                aria-labelledby="feature-text-title">
                <div class="feature-section__content">
                    <h2 class="feature-section__title" id="feature-text-title">
                        <svg class="feature-section__spark" viewBox="0 0 40 40" aria-hidden="true">
                            <path
                                d="M20 3.5 25.2 14l11.3 1.6-8.2 8 1.9 11.3L20 29.5 9.8 34.9l1.9-11.3-8.2-8L14.8 14 20 3.5Z"
                                fill="#ff8589" stroke="#171717" stroke-width="2.5" stroke-linejoin="round" />
                        </svg>
                        <span>Say Goodbye to Boring Placeholder Text!</span>
                    </h2>
                    <p class="feature-section__description">
                        Say goodbye to Lorem Ipsum. Build with realistic JSON responses
                        and focus on your frontend while DataDino keeps your prototypes moving.
                    </p>
                    <a class="feature-section__button feature-section__button--coral" href="/docs">Try it Now</a>
                </div>
                <a class="feature-section__scroll" href="#feature-resources"
                    aria-label="Explore ready-to-use resources">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v17m-7-7 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.7"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </section>

            <section class="feature-section feature-section--resources" id="feature-resources"
                aria-labelledby="feature-resources-title">
                <div class="feature-section__content">
                    <h2 class="feature-section__title" id="feature-resources-title">
                        <span>Ready-to-Use Resources<br class="feature-section__desktop-break"> for Your Projects</span>
                        <svg class="feature-section__spark" viewBox="0 0 40 40" aria-hidden="true">
                            <path
                                d="M20 3.5 25.2 14l11.3 1.6-8.2 8 1.9 11.3L20 29.5 9.8 34.9l1.9-11.3-8.2-8L14.8 14 20 3.5Z"
                                fill="#b9b6ff" stroke="#171717" stroke-width="2.5" stroke-linejoin="round" />
                        </svg>
                    </h2>
                    <p class="feature-section__description">
                        Explore handy JSON examples and resources to speed up frontend development
                        and create dynamic prototypes without backend setup.
                    </p>
                    <a class="feature-section__button feature-section__button--lavender" href="/docs">View More</a>
                </div>
                <a class="feature-section__scroll" href="#feature-images" aria-label="Explore placeholder images">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v17m-7-7 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.7"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </section>

            <section class="feature-section feature-section--images" id="feature-images"
                aria-labelledby="feature-images-title">
                <div class="feature-section__content">
                    <h2 class="feature-section__title" id="feature-images-title">
                        <svg class="feature-section__spark" viewBox="0 0 40 40" aria-hidden="true">
                            <path
                                d="M20 3.5 25.2 14l11.3 1.6-8.2 8 1.9 11.3L20 29.5 9.8 34.9l1.9-11.3-8.2-8L14.8 14 20 3.5Z"
                                fill="#ff8589" stroke="#171717" stroke-width="2.5" stroke-linejoin="round" />
                        </svg>
                        <span>Placeholder Images? No Problem!</span>
                    </h2>
                    <p class="feature-section__description">
                        Need images on the fly? Explore placeholder-image examples and add
                        visuals to your prototype without image hunting or complex setup.
                    </p>
                    <a class="feature-section__button feature-section__button--coral" href="/docs">Generate Now</a>
                </div>
                <a class="feature-section__scroll" href="#site-footer" aria-label="Continue to the footer">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v17m-7-7 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.7"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </section>
            <section class="try-demo" id="try-it" aria-labelledby="try-demo-title">
                <div class="try-demo__content">
                    <h2 class="try-demo__title" id="try-demo-title">
                        <span aria-hidden="true">✦</span>
                        Try it yourself!
                    </h2>
                    <p class="try-demo__intro">
                        Use the dropdown to get results for different resources.
                    </p>

                    <div class="try-demo__request" aria-label="API request">
                        <span>fetch('https://dummyjson.com/</span>
                        <select id="demo-resource" aria-label="Choose a resource">
                            <option value="products">products</option>
                            <option value="carts">carts</option>
                            <option value="users">users</option>
                            <option value="posts">posts</option>
                            <option value="comments">comments</option>
                            <option value="quotes">quotes</option>
                            <option value="recipes">recipes</option>
                            <option value="todos">todos</option>
                        </select>
                        <span>?limit=10')</span>
                    </div>

                    <div class="try-demo__response" id="demo-response" aria-busy="true">
                        <div class="try-demo__toolbar">
                            <span>JSON response</span>
                            <span id="demo-status" role="status" aria-live="polite">Loading data…</span>
                        </div>
                        <pre><code id="demo-output">Waiting for API response…</code></pre>
                    </div>

                    <a class="try-demo__button" href="/docs">View Docs</a>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
</body>

</html>